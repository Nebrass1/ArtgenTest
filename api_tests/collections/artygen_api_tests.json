{
  "info": {
    "name": "Artygen API Tests",
    "description": "Tests complets des APIs de la plateforme Artygen",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Get CSRF token for POST requests",
          "if (pm.request.method === 'POST') {",
          "    pm.sendRequest({",
          "        url: pm.variables.get('base_url') + '/accounts/login/',",
          "        method: 'GET'",
          "    }, function (err, res) {",
          "        if (!err) {",
          "            var csrfToken = res.cookies.get('csrftoken');",
          "            if (csrfToken) {",
          "                pm.variables.set('csrf_token', csrfToken.value);",
          "                console.log('CSRF Token set:', csrfToken.value);",
          "            }",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "🔐 AUTHENTICATION - Tests d'authentification",
      "item": [
        {
          "name": "TC-API-AUTH-01 - Get Login Page",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Login page loaded\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"login\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/accounts/login/",
              "host": ["{{base_url}}"],
              "path": ["accounts", "login", ""]
            }
          },
          "response": []
        },
        {
          "name": "TC-API-AUTH-02 - Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 302\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});",
                  "pm.test(\"Login successful\", function () {",
                  "    // Check for success indicators",
                  "    var responseText = pm.response.text();",
                  "    var isSuccess = responseText.includes(\"Success\") || ",
                  "                   responseText.includes(\"profile\") || ",
                  "                   responseText.includes(\"dashboard\") ||",
                  "                   pm.response.headers.get('Location') && pm.response.headers.get('Location').includes('profile');",
                  "    pm.expect(isSuccess).to.be.true;",
                  "});",
                  "// Save session cookie",
                  "var sessionCookie = pm.cookies.get('sessionid');",
                  "if (sessionCookie) {",
                  "    pm.environment.set('session_id', sessionCookie);",
                  "    console.log('Session ID saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{auth_username}}"
                },
                {
                  "key": "password",
                  "value": "{{auth_password}}"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/accounts/login/",
              "host": ["{{base_url}}"],
              "path": ["accounts", "login", ""]
            }
          },
          "response": []
        },
        {
          "name": "TC-API-AUTH-03 - Get User Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Profile accessible\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"profile\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/profile/",
              "host": ["{{base_url}}"],
              "path": ["profile", ""]
            }
          },
          "response": []
        }
      ]
    },
