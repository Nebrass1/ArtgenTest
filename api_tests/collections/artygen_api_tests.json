        {
          "name": "TC-API-GEN-02 - Generate Image Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(30000);",
                  "});",
                  "pm.test(\"Image generation processed\", function () {",
                  "    var responseText = pm.response.text();",
                  "    var isProcessed = responseText.includes(\"image\") || ",
                  "                     responseText.includes(\"artwork\") || ",
                  "                     responseText.includes(\"generated\") ||",
                  "                     responseText.includes(\"result\");",
                  "    pm.expect(isProcessed).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "prompt",
                  "value": "A beautiful sunset over mountains in digital art style"
                },
                {
                  "key": "style",
                  "value": "Digital Art"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/generate/",
              "host": ["{{base_url}}"],
              "path": ["generate", ""]
            }
          },
          "response": []
        }
      ]
