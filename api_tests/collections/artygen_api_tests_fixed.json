{
  "info": {
    "name": "Artygen API Tests - FIXED",
    "description": "Tests corrigés des APIs de la plateforme Artygen",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🏠 PAGES PUBLIQUES - Tests sans authentification",
      "item": [
        {
          "name": "TC-API-HOME-01 - Home Page",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Home page loaded\", function () {",
                  "    const responseText = pm.response.text().toLowerCase();",
                  "    pm.expect(responseText.length).to.be.greaterThan(1000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/"
          }
        },
        {
          "name": "TC-API-CAT-01 - Categories Page",
