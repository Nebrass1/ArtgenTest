                  "pm.test(\"Login page accessible\", function () {",
                  "    const responseText = pm.response.text().toLowerCase();",
                  "    pm.expect(responseText.length).to.be.greaterThan(1000);",
                  "});",
                  "",
                  "// Extraire le token CSRF pour les tests suivants",
                  "const csrfCookie = pm.cookies.get('csrftoken');",
                  "if (csrfCookie) {",
                  "    pm.environment.set('csrf_token', csrfCookie);",
                  "    console.log('CSRF Token extracted:', csrfCookie);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/accounts/login/"
          }
        }
